.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Anything account- or machine-specific. blink-light.json is this machine's own
# config (device serial, calendar provider, schedule); blink-light.example.json
# is the committed template. The secret scan also refuses to track these.
blink-light.json
blink-light.local.json
*.local.json

# Token caches, in case one is ever pointed at the repo instead of
# %LOCALAPPDATA%\BlinkLight.
*token-cache*.json
*.token
.env
