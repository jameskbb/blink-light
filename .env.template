# Copy to .env and fill in. .env is gitignored; this template is not.
#
#   copy .env.template .env
#
# Real environment variables win over anything set here, so a scheduled task
# can override the file without editing it.

# --- Microsoft 365 calendar (calendar.provider = "graph") -------------------
# From your Entra app registration's Overview page.
# Application (client) ID:
BLINK_LIGHT_GRAPH_CLIENT_ID=
# Directory (tenant) ID. "organizations" works for any work account; a
# single-tenant app registration needs its own tenant id here.
BLINK_LIGHT_GRAPH_TENANT_ID=organizations

# --- Optional overrides -----------------------------------------------------
# "graph" (Microsoft 365, needs the two values above) or "outlook" (desktop COM).
# BLINK_LIGHT_CALENDAR_PROVIDER=graph
# Which blink(1) to drive, if you have more than one plugged in.
# BLINK_LIGHT_DEVICE_SERIAL=
