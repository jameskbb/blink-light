    },
    "meeting_soon": {
      "scene": "meeting_soon_scene"
    },
    "timer_done": {
      "scene": "timer_done_scene"
    }
  },
  "routines": {
    "hydrate": {
      "completion_action": {
        "preset": "hydrate_due"
      },
      "description": "45 minute hydration reminder.",
      "phases": [
        {
          "action": {
            "preset": "available"
          },
          "minutes": 45,
          "name": "hydrate_wait"
        }
      ]
    },
    "long_break": {
      "completion_action": {
        "preset": "timer_done"
      },
      "description": "Longer 15 minute reset.",
      "phases": [
        {
          "action": {
            "preset": "break"
          },
          "minutes": 15,
          "name": "long_break"
        }
      ]
    },
    "pomodoro": {
      "completion_action": {
        "preset": "timer_done"
      },
      "description": "25 minutes of focus followed by a 5 minute break.",
      "phases": [
        {
          "action": {
            "preset": "focus"
          },
          "minutes": 25,
          "name": "focus"
        },
        {
          "action": {
            "preset": "break"
          },
          "minutes": 5,
          "name": "short_break"
        }
      ]
    },
    "short_break": {
      "completion_action": {
        "preset": "timer_done"
      },
      "description": "Quick 5 minute reset.",
      "phases": [
        {
          "action": {
            "preset": "break"
          },
          "minutes": 5,
          "name": "short_break"
        }
      ]
    },
    "stand": {
      "completion_action": {
        "preset": "meeting_soon"
      },
      "description": "60 minute stand-and-stretch reminder.",
      "phases": [
        {
          "action": {
            "preset": "available"
          },
          "minutes": 60,
          "name": "stand_wait"
        }
      ]
    }
  },
  "rules": [
    {
      "action": {
        "preset": "timer_done"
      },
      "name": "timer-completed",
      "when": {
        "routine_phase": "completed"
      }
    },
    {
      "action": {
        "preset": "away"
      },
      "name": "idle-away",
      "when": {
        "idle_seconds_gte": 600
      }
    }
  ],
